generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat="cjs"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(uuid())
  email String @unique
  name String
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions Questions[]
  answers Answers[]
}

model Questions{
  id String @id @default(uuid())
  title String
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user User @relation(fields: [userId], references: [id])
  answers Answers[]
}

model Answers{
  id String @id @default(uuid())
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  questionId String
  user User @relation(fields: [userId], references: [id])
  question Questions @relation(fields: [questionId], references: [id])
}